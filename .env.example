# ═══════════════════════════════════════════════════════
# LLM Wiki Demo — 环境变量配置
# 复制为 .env 后编辑填入真实值
# ═══════════════════════════════════════════════════════

# ── LLM API（必填）──
# 支持任何 OpenAI 兼容 API（通义千问 / DeepSeek / OpenRouter 等）
QWEN_API_KEY=***
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_ID=deepseek-v4-pro

# ── MinIO 对象存储 ──
USE_MINIO=true
MINIO_ENDPOINT=***
MINIO_ACCESS_KEY=***
MINIO_SECRET_KEY=***
MINIO_BUCKET=wiki-test

# ── JWT 密钥（留空则首次启动自动生成）──
JWT_SECRET=

# ── 注册白名单（逗号分隔，留空则不限制注册）──
ALLOWED_USERS=

# ── 可选：阿里云 IQS 搜索 API ──
ALIYUN_API_KEY=
