# LLM API Configuration (Qwen/DeepSeek compatible)
QWEN_API_KEY=sk-your-api-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_ID=deepseek-v4-pro

# Aliyun IQS Search API
ALIYUN_API_KEY=your-aliyun-api-key-here

# JWT Configuration (auto-generated on first run if empty)
JWT_SECRET=

# Optional: Custom model provider (openai/anthropic/custom)
MODEL_PROVIDER=openai_compatible

# 注册白名单（逗号分隔用户名，留空则不限制）
# 测试期间填写允许注册的用户名，上线后可清空开放注册
ALLOWED_USERS=testuser1,testuser2,admin
